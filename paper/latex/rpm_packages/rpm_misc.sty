% label formating
%=====================================================
% \equref
% \providecommand{\eqref}[1]{Eq.~\ref{#1}}
\providecommand{\equref}[1]{Eq.~(\ref{#1})}
% \figref
\providecommand{\figref}[1]{Fig.~\ref{#1}}
% \tabref
\providecommand{\tabref}[1]{Tab.~\ref{#1}}
% \algoref
\providecommand{\algoref}[1]{Algorithm~\ref{#1}}
% \secref
\providecommand{\secref}[1]{\textsection\ref{#1}}
% \chapref
\providecommand{\chapref}[1]{Chap.~\ref{#1}}
% Theorem ref
\providecommand{\Thmref}[1]{Theorem~\ref{#1}}
\providecommand{\thmref}[1]{Theorem.~\ref{#1}}

\providecommand{\lemref}[1]{Lemma.~\ref{#1}}

% Appendix ref
\providecommand{\apref}[1]{Appendix~\ref{#1}}

% symbol footnote: syntax \symbolfootnote[1]{text}
% 1 - *
% 2 - dagger
% 3 - double dagger
% 4 - ...9 see page 175 of latex manual
\long\def\symbolfootnote[#1]#2{\begingroup%
\def\thefootnote{\fnsymbol{footnote}}\footnote[#1]{#2}\endgroup}

\newcommand{\gr}[1]{{\textcolor{green}{#1}}}
\newcommand{\bl}[1]{{\textcolor{blue}{#1}}}
\newcommand{\bs}[1]{{\boldsymbol{#1}}}
\newcommand{\tb}[1]{{\textbf{#1}}}

% accented words
%=====================================================
\def\naive{{na\"\i ve} }%
\def\Naive{{Na\"\i ve} }%
\def\naively{{na\"\i vely} }%
\def\Naively{{Na\"\i vely} }%
