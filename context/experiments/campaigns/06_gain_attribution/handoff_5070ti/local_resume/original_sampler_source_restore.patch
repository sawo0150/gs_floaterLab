+class RecentIntervalWindowRandomReshuffling:
+    """Causal RR over frames from only the most recent keyframe intervals.
+
+    Each non-empty ``add`` call closes one keyframe interval.  The active pool
+    is the union of the most recent ``window_size`` intervals.  Frames evicted
+    with an old interval can no longer be drawn, while newly arrived frames are
+    inserted into a random position of the unfinished RR epoch.  Consequently,
+    a stable window is exact random reshuffling and no future interval is used.
+    """
+
+    def __init__(self, seed=0, window_size=10):
+        self.rng = random.Random(seed)
+        self.window_size = int(window_size)
+        if self.window_size < 1:
+            raise ValueError("window_size must be >= 1")
+        self.active, self.remaining, self.counts = [], [], Counter()
+        self.intervals = []
+
+    def add(self, ids):
+        ids = list(ids)
+        if not ids:
+            return
+        self.intervals.append(ids)
+        for item in ids:
+            self.counts[item] += 0
+        retained = self.intervals[-self.window_size:]
+        self.active = [item for interval in retained for item in interval]
+        active_set = set(self.active)
+        self.remaining = [item for item in self.remaining if item in active_set]
+        for item in ids:
+            self.remaining.insert(self.rng.randrange(len(self.remaining) + 1), item)
+
+    def draw(self):
+        if not self.remaining:
+            self.remaining = self.active.copy()
+            self.rng.shuffle(self.remaining)
+        item = self.remaining.pop()
+        self.counts[item] += 1
+        return item
+
