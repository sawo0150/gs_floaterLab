# Python/cache artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Local/editor artifacts
.DS_Store
Thumbs.db

# Nested repository metadata should not be vendored into this workspace repo.
**/.git/

# Large local datasets and generated experiment outputs. Keep lightweight
# documentation/log summaries in Git; store full artifacts externally.
data/**
!data/
!data/README.md

data_trash_20260707/

results/**
!results/
!results/README.md
!results/logs/
!results/logs/**

# exp69 axes: raw per-run outputs (PLY/checkpoints/logs), keep analysis/reports
exp69_axes/results/

# Large generated experiment assets. These exceed GitHub's normal Git limits
# and should be stored externally or with Git LFS if needed later.
context/reference/papers/merged_original.pdf
**/point_cloud/iteration_*/point_cloud*.ply
**/point_cloud_*.ply
floater_share/
floater_share.zip

# Locally retained experiment exports; do not add binary maps or archives to Git.
improved_results.zip
share/**/*.ply
results/by_exp/

# --- paper/ ---
# LaTeX 빌드 산출물
paper/latex/**/*.aux
paper/latex/**/*.log
paper/latex/**/*.out
paper/latex/**/*.bbl
paper/latex/**/*.blg
paper/latex/**/*.synctex.gz
paper/latex/**/*.fdb_latexmk
paper/latex/**/*.fls
paper/latex/main.pdf
paper/latex/rebuttal.pdf
# tab/ 은 make_tables.py 생성물 — CSV가 원본이다
paper/latex/tab/*.tex
# run 원자료는 원격 머신에. manifest/metrics 만 커밋한다
paper/results/runs/**
!paper/results/runs/*/
!paper/results/runs/*/manifest.json
!paper/results/runs/*/metrics.csv

# 참고 논문 PDF: 저작권 자료 + 대용량(파일당 최대 50MB)이라 git에 넣지 않는다.
# 무엇이 어디에 왜 있는지는 paper/refs/INDEX.md 가 추적한다.
paper/refs/**
!paper/refs/
!paper/refs/*/
!paper/refs/INDEX.md

# 로컬 LaTeX 빌드 (paper/scripts/tex.sh)
paper/build/
paper/.sync-snapshot/
